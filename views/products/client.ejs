<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Beauty Glow Pro - Gestion des Produits</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://unpkg.com/lucide@latest"></script>
  
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

   <link rel="stylesheet" href="../css/client.css">
</head>
<body>
 
  <div class="sidebar">
    <div class="logo">
      <i class="fas fa-spa"></i>
      <span>Beauty Glow</span>
    </div>

    <div class="sidebar-menu">
      <a href="#" class="sidebar-item active" id="productsLink">
        <i data-lucide="package"></i>
        <span>Produits</span>
      </a>

      <a href="#" class="sidebar-item" id="cartLink">
        <i data-lucide="shopping-cart"></i>
        <span>Panier</span>
        <span class="cart-counter" style="display: none">0</span>
      </a>

      <a href="#" class="sidebar-item" id="profileLink">
        <i data-lucide="user"></i>
        <span>Profil</span>
      </a>
    </div>

    <div class="sidebar-footer">
      <form action="/" method="POST" class="logout-form" onsubmit="localStorage.removeItem('cart')">
        <button type="submit" class="logout-button">
          <div class="sidebar-item">
            <i data-lucide="log-out"></i>
            <span>Déconnexion</span>
          </div>
        </button>
      </form>
    </div>
  </div>

  
  <div class="main-content" id="productsSection">
    <div class="welcome-section">
      <div class="welcome-message">
        <h2>Bienvenue, <%= user.username %> ! <span style="font-size: 0.9em;">😊</span></h2>
      </div>
      <div class="profile-info">
        <i data-lucide="user"></i>
        <span><%= user.username %></span>
      </div>
    </div>

    <div class="products-grid">
      <% for (let type in grouped) { %>
        <% if (grouped[type].length > 0) { %>
          <h3 style="grid-column: 1 / -1; color: var(--primary-dark); margin-top: 20px;">
            <%= type.charAt(0).toUpperCase() + type.slice(1) %>
          </h3>
          <% grouped[type].forEach(p => { %>
            <div class="product-card">
              <span class="product-type"><%= type.toUpperCase() %></span>

              <% if (p.image) { %>
                <div class="product-image-container">
                  <img src="<%= p.image %>" alt="<%= p.name %>" class="product-image">
                </div>
              <% } %>

              <h3 class="product-name"><%= p.name %></h3>

              <% if (p.User && p.User.brandName) { %>
                <p class="product-brand" style="color: var(--accent-color); font-size: 0.9rem;">
                  <%= p.User.brandName %>
                </p>
              <% } %>

              <p class="product-details"><%= p.description || 'Aucune description disponible' %></p>
              <p class="product-price" style="font-weight: bold; margin: 10px 0;"><%= p.price.toFixed(2) %> €</p>

              <button class="add-to-cart-btn update-password-btn" data-product-id="<%= p.id %>">
                <i data-lucide="shopping-cart"></i> Ajouter au panier
              </button>
            </div>
          <% }) %>
        <% } %>
      <% } %>
    </div>
  </div>


  <div class="main-content" id="profileSection" style="display: none;">
    <div class="welcome-section">
      <h2 class="welcome-message">Profil</h2>
      <div class="profile-info">
        <i data-lucide="user"></i>
        <span><%= user.username %></span>
      </div>
    </div>

    <div class="profile-container">
      <div class="profile-header">
        <h3>Informations du profil</h3>
        <button class="back-btn" id="backToDashboard">
          <i data-lucide="arrow-left"></i> Retour
        </button>
      </div>

      <div class="profile-info-section">
        <h4>Informations personnelles</h4>
        <form method="POST" action="" class="password-form">
          <div class="info-row">
            <div class="password-row">
              <div class="password-field">
                <label for="username">Nom d'utilisateur</label>
                <input type="text" id="username" name="username" value="<%= user.username %>">
              </div>
              <div class="password-field">
                <label for="email">Adresse email</label>
                <input type="email" id="email" name="email" value="<%= user.email %>">
              </div>
            </div>
          </div>

          <div class="profile-info-section">
            <h4>Changer le profil</h4>
            <div class="password-row">
              <div class="password-field">
                <label for="currentPassword">Mot de passe actuel</label>
                <input type="password" id="currentPassword" name="currentPassword" style="width: 560px;">
              </div>
            </div>

            <div class="password-row">
              <div class="password-field">
                <label for="newPassword">Nouveau mot de passe</label>
                <input type="password" id="newPassword" name="newPassword">
              </div>
              <div class="password-field">
                <label for="confirmPassword">Confirmer le mot de passe</label>
                <input type="password" id="confirmPassword" name="confirmPassword">
              </div>
            </div>

            <br><br>
            <button type="submit" class="update-password-btn">Changer le profil</button>
          </div>
        </form>
      </div>
    </div>
  </div>


  <div class="main-content" id="cartSection" style="display: none;">
    <div class="welcome-section">
      <h2 class="welcome-message">Votre Panier</h2>
      <div class="profile-info">
        <i data-lucide="user"></i>
        <span><%= user.username %></span>
      </div>
    </div>

    <div class="cart-container">
      <div class="cart-items">
        <h3>Articles dans votre panier</h3>
        <div id="cartItemsList">
          <div class="empty-cart-message">
            <div class="empty-icon">
              <i data-lucide="shopping-cart"></i>
            </div>
            <p>Votre panier est vide</p>
          </div>
        </div>
      </div>

      <div class="cart-summary">
        <h3>Résumé</h3>
        <div class="summary-row"><span>Sous-total</span><span id="subtotal">0.00 €</span></div>
        <div class="summary-row"><span>Livraison</span><span>Gratuite</span></div>
        <div class="summary-row total"><span>Total</span><span id="total">0.00 €</span></div>
    

<div style="text-align: center; margin-top: 20px;">
  <button id="confirmOrderBtn" class="update-password-btn" style="background-color: #85e085; padding: 10px 20px; border-radius: 10px;">
     Passer la commande
  </button>
</div>
 </div>
    </div>
  </div>

<script>
  lucide.createIcons();

  const productsLink = document.getElementById('productsLink');
  const profileLink = document.getElementById('profileLink');
  const panierLink = document.getElementById('cartLink');
  const productsSection = document.getElementById('productsSection');
  const profileSection = document.getElementById('profileSection');
  const panierSection = document.getElementById('cartSection');
  const backToDashboard = document.getElementById('backToDashboard');

  let cart = JSON.parse(localStorage.getItem('cart')) || [];

  function saveCartToLocalStorage() {
    localStorage.setItem('cart', JSON.stringify(cart));
  }

  function updateCartCounter() {
    const counter = document.querySelector('.cart-counter');
    if (counter) {
      const totalQty = cart.reduce((acc, item) => acc + item.qty, 0);
      counter.textContent = totalQty;
      counter.style.display = totalQty > 0 ? 'flex' : 'none';
    }
  }

  function afficherContenuPanier() {
    const liste = document.getElementById("cartItemsList");
    liste.innerHTML = "";

    if (cart.length === 0) {
      liste.innerHTML = `
        <div class="empty-cart-message">
          <div class="empty-icon">
            <i data-lucide="shopping-cart"></i>
          </div>
          <p>Votre panier est vide</p>
        </div>`;
      document.getElementById("subtotal").textContent = `0.00 €`;
      document.getElementById("total").textContent = `0.00 €`;
      return;
    }

    cart.forEach((produit, index) => {
      const item = document.createElement("div");
      item.className = "ligne-panier";
      const totalPrice = (produit.prix * produit.qty).toFixed(2);

   item.innerHTML = `
  <div style="display: flex; gap: 15px; align-items: center;">
    <img src="${produit.image}" alt="${produit.nom}" class="image-panier" style="width: 120px; height: auto; border-radius: 8px;" />
    <div class="infos-panier" style="flex: 1;">
      <h4 style="margin: 0;">${produit.nom} <span style="font-size: 0.9em; color: gray;">x${produit.qty}</span></h4>
      <p style="margin: 5px 0;">${produit.marque}</p>
      <span style="font-weight: bold;">${totalPrice} €</span><br>
      <button class="cancel-btn update-password-btn" style="margin-top: 10px;" data-index="${index}">
        <i data-lucide="x-circle"></i> Annuler
      </button>
    </div>
  </div>`;

      liste.appendChild(item);
    });

    document.querySelectorAll('.cancel-btn').forEach(btn => {
      btn.addEventListener('click', function () {
        const index = parseInt(this.getAttribute('data-index'));
        if (cart[index].qty > 1) {
          cart[index].qty -= 1;
        } else {
          cart.splice(index, 1);
        }
        saveCartToLocalStorage();
        updateCartCounter();
        afficherContenuPanier();
      });
    });

    calculerTotalPanier();
    lucide.createIcons();
  }

  function calculerTotalPanier() {
    let total = 0;
    cart.forEach(p => {
      total += p.prix * p.qty;
    });
    document.getElementById("subtotal").textContent = `${total.toFixed(2)} €`;
    document.getElementById("total").textContent = `${total.toFixed(2)} €`;
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateCartCounter();
    afficherContenuPanier();
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        const carte = this.closest(".product-card");
        const productId = this.dataset.productId;
        const existing = cart.find(p => p.id === productId);

        if (existing) {
          existing.qty += 1;
        } else {
          const produit = {
            id: productId,
            nom: carte.querySelector(".product-name")?.textContent,
            prix: parseFloat(carte.querySelector(".product-price")?.textContent.replace(" €", "")),
            image: carte.querySelector(".product-image")?.getAttribute("src"),
            marque: carte.querySelector(".product-brand")?.textContent,
            qty: 1
          };
          cart.push(produit);
        }

        saveCartToLocalStorage();
        updateCartCounter();
        afficherContenuPanier();

        const originalHTML = this.innerHTML;
        this.innerHTML = '<i data-lucide="check"></i> Ajouté !';
        lucide.createIcons();

        setTimeout(() => {
          this.innerHTML = originalHTML;
          lucide.createIcons();
        }, 1000);
      });
    });

      const confirmBtn = document.getElementById("confirmOrderBtn");
      confirmBtn.addEventListener("click", () => {
        if (cart.length === 0) {
          Swal.fire({
            icon: 'warning',
            title: 'Panier vide',
            text: 'Ajoutez des produits avant de passer la commande.',
            confirmButtonColor: '#d33',
          });
        } else {
          Swal.fire({
            title: 'Informations de livraison',
            html:
              `<input type="text" id="fullname" class="swal2-input" placeholder="Nom complet">
               <input type="email" id="email" class="swal2-input" placeholder="Email">
               <input type="tel" id="phone" class="swal2-input" placeholder="Téléphone">
               <input type="text" id="address" class="swal2-input" placeholder="Adresse">`,
            confirmButtonText: 'Confirmer',
            confirmButtonColor: '#FFC0CB',
            focusConfirm: false,
            preConfirm: () => {
              const fullname = Swal.getPopup().querySelector('#fullname').value;
              const email = Swal.getPopup().querySelector('#email').value;
              const phone = Swal.getPopup().querySelector('#phone').value;
              const address = Swal.getPopup().querySelector('#address').value;

              if (!fullname || !email || !phone || !address) {
                Swal.showValidationMessage(`Veuillez remplir tous les champs`);
                return false;
              }

              return { fullname, email, phone, address };
            }
          }).then((result) => {
            if (result.isConfirmed) {
              Swal.fire({
                icon: 'success',
                title: 'Commande confirmée !',
                text: `Merci ${result.value.fullname}, votre commande a été enregistrée.`,
                confirmButtonColor: '#28a745',
              });

              cart = [];
              saveCartToLocalStorage();
              updateCartCounter();
              afficherContenuPanier();
            }
          });
        }
      });
  
    panierLink.addEventListener('click', (e) => {
      e.preventDefault();
      productsSection.style.display = 'none';
      profileSection.style.display = 'none';
      panierSection.style.display = 'block';
      profileLink.classList.remove('active');
      productsLink.classList.remove('active');
      panierLink.classList.add('active');
      afficherContenuPanier();
    });

    profileLink.addEventListener('click', (e) => {
      e.preventDefault();
      productsSection.style.display = 'none';
      profileSection.style.display = 'block';
      panierSection.style.display = 'none';
      profileLink.classList.add('active');
      productsLink.classList.remove('active');
      panierLink.classList.remove('active');
    });

    productsLink.addEventListener('click', (e) => {
      e.preventDefault();
      productsSection.style.display = 'block';
      profileSection.style.display = 'none';
      panierSection.style.display = 'none';
      profileLink.classList.remove('active');
      productsLink.classList.add('active');
      panierLink.classList.remove('active');
    });

    backToDashboard.addEventListener('click', () => {
      productsSection.style.display = 'block';
      profileSection.style.display = 'none';
      panierSection.style.display = 'none';
      profileLink.classList.remove('active');
      productsLink.classList.add('active');
      panierLink.classList.remove('active');
    });
  });
</script>
</body>
</html>