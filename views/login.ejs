<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Beauty Glow Pro - Connexion</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <header>
    <div class="container nav-container">
      <div class="logo">
        <i class="fas fa-spa"></i>
        <span>Beauty Glow Pro</span>
      </div>
      <div class="nav-links">
        <a href="/">Accueil</a>
        <a href="#">Produits</a>
        <a href="#">Conseils</a>
        <a href="/auth/login" class="active">Login</a>
        <a href="/auth/register">Register</a>
      </div>
    </div>
  </header>
  
  <main class="login-main">
    <div class="login-container">
      <h2>Connexion à votre espace</h2>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error">
          <i class="fas fa-exclamation-circle"></i>
          
          <span><%= error %></span>  <!-- Affichage mtaa l'erreur li jeyya mil backend -->
        </div>
      <% } %>

      <form method="POST" action="/auth/login">
        <div class="input-group">
          <label>Email</label>
          <div class="input-container">
            <i class="fas fa-envelope"></i>
            <input type="email" name="email" required />
          </div>
        </div>
        
        <div class="input-group">
          <label>Mot de passe</label>
          <div class="input-container">
            <i class="fas fa-lock"></i>
            <input type="password" name="password" required />
          </div>
        </div>

        <button type="submit">
          <span>Se connecter</span>
        </button>
      </form>
      
      <div class="social-login">
        <p>Ou se connecter avec</p>
        <div class="social-icons">
          <a href="#" class="social-icon facebook">
            <i class="fab fa-facebook-f"></i>
          </a>
          <a href="#" class="social-icon google">
            <i class="fab fa-google"></i>
          </a>
          <a href="#" class="social-icon apple">
            <i class="fab fa-apple"></i>
          </a>
        </div>
      </div>
      
      <p class="footer-text">
        Pas encore de compte ? <a href="/auth/register">S'inscrire</a>
      </p>
    </div>
  </main>
  
  <footer>
    <div class="container">
      <p>&copy; 2025 Beauty Glow Pro. Tous droits réservés.</p>
    </div>
  </footer>
</body>
</html>